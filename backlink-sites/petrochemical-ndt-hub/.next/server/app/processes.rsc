0:["jyLlA_7pvpTXRXMgH6w_3",[[["",{"children":["processes",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["processes",{"children":["__PAGE__",{},[["$L1",["$","div",null,{"children":[["$","h1",null,{"className":"text-4xl font-bold text-orange-800 mb-8","children":"Processing Unit Assessment"}],["$","article",null,{"className":"prose prose-lg max-w-none","children":[["$","section",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-2xl font-bold text-orange-800 mb-4","children":"Crude Distillation Unit Inspection"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":"The crude distillation unit (CDU) represents the entry point for all crude oil into a refinery. Operating at temperatures exceeding 350°C and pressures up to 25 bar, CDU equipment endures some of the most severe service conditions found in refining. The furnace tubes carry fluid under thermal stress, experiencing brittle failure risks and creep damage over time. Fired heater inspection requires specialized radiographic examination of tube welds, combined with creep rupture damage detection techniques."}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":["The atmospheric distillation tower itself requires periodic ultrasonic scanning for wall thinning, corrosion pitting, and localized erosion. Internal trays and support structures within the tower must be inspected through available access points. ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-orange-600 hover:text-orange-800 font-semibold","children":"NDT consulting services"}]," experienced with CDU assessment bring knowledge of typical failure modes, remaining-life assessment methodologies, and regulatory requirements specific to atmospheric distillation operations."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":["Heat exchanger networks serving CDU require systematic inspection strategies. Tube-side fouling deposits obscure eddy current examination results, necessitating chemical cleaning prior to inspection. ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-orange-600 hover:text-orange-800 font-semibold","children":"Digital twin solutions"}]," integrate inspection data with operational parameters to identify heat exchanger segments most at risk from continued operation, supporting capital investment decisions."]}]]}],["$","section",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-2xl font-bold text-orange-800 mb-4","children":"Hydrotreating Unit Equipment"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":"Hydrotreating processes remove sulfur, nitrogen, and other impurities from refinery products through catalytic hydrogenation reactions. Operating under hydrogen pressure and elevated temperature, the reactors are susceptible to stress corrosion cracking in austenitic materials and hydrogen attack in ferritic steels. Periodic inspection via phased array ultrasonic testing with TOFD sizing establishes crack initiation and growth patterns, informing continued operation decisions and planned replacement schedules."}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":["Reactor internals including catalyst support structures and product distribution systems require assessment through removable inspection plugs and access openings. Magnetic particle testing of critical welds combined with visual inspection of internal components confirms mechanical integrity. ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-orange-600 hover:text-orange-800 font-semibold","children":"NDT training programs"}]," prepare facility personnel for systematic internal inspection procedures that maximize information gathering while minimizing turnaround duration and re-commissioning risks."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":["Hydrogen barrier materials and corrosion-resistant alloy cladding require specialized assessment. Ultrasonic thickness measurement through cladding layers demands methodology development and equipment calibration reflecting actual material systems. ",["$","a",null,{"href":"https://ndt-connect.com","rel":"noopener","className":"text-orange-600 hover:text-orange-800 font-semibold","children":"NDTConnect platform"}]," captures inspection procedures and equipment performance data for continuous improvement of NDT execution quality."]}]]}],["$","section",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-2xl font-bold text-orange-800 mb-4","children":"Catalytic Conversion Units"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":"Fluid catalytic cracking (FCC) units operate at high temperatures with abrasive catalyst particles in circulation. Erosion-corrosion of process piping causes localized metal loss that may not be detected by conventional wall thickness measurements at arbitrary locations. Systematic ultrasonic scanning combined with 3D modeling identifies erosion patterns, distinguishing uniform corrosion from problematic erosion zones requiring accelerated replacement."}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":["Catalyst circulation systems experience unique inspection challenges including complexity of dense-phase flow piping, high operating temperatures, and difficult access for conventional ultrasonic scanning. Advanced NDT techniques including guided wave ultrasonics enable rapid screening from accessible points, with follow-up detailed inspection at identified concern areas. ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-orange-600 hover:text-orange-800 font-semibold","children":"Atlantis NDT"}]," provides specialized expertise in FCC equipment assessment developed through extensive industry experience."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":"Regenerator systems where catalyst is heated in air present corrosion challenges distinct from process-side equipment. Thermal stressing and oxidation accelerate degradation of ferrous materials. Periodic radiographic examination combined with remnant strength assessment informs replacement decisions that must coordinate with catalyst supply strategy to maintain uninterrupted processing capability."}]]}],["$","section",null,{"children":[["$","h2",null,{"className":"text-2xl font-bold text-orange-800 mb-4","children":"Alkylation and Treating Unit Assessment"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":"Alkylation units using hydrofluoric acid or sulfuric acid present extreme corrosiveness challenges. Specialized corrosion-resistant alloys provide necessary protection but require periodic assessment to detect localized corrosion escape failures. Ultrasonic examination demands careful methodological development reflecting actual material properties and acid exposure conditions."}],["$","p",null,{"className":"text-gray-700 leading-relaxed","children":"Amine-based treating units for acid gas removal require monitoring for equipment degradation from amine carryover, temperature cycling, and pressure variations. Systematic inspection of amine contactors, regenerators, and downstream equipment establishes integrity baselines and predicts remaining service life. Risk-based inspection frameworks prioritize equipment with highest consequence potential, optimizing resource allocation across complex facility networks."}]]}]]}]]}],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","processes","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/f0a6f27ddf81b5f6.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","children":["$","body",null,{"className":"bg-gradient-to-b from-orange-50 to-white","children":[["$","script",null,{"async":true,"src":"https://www.googletagmanager.com/gtag/js?id=G-1EF92RXSVR"}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"\n        window.dataLayer = window.dataLayer || [];\n        function gtag(){dataLayer.push(arguments);}\n        gtag('js', new Date());\n        gtag('config', 'G-1EF92RXSVR');\n      "}}],["$","header",null,{"className":"border-b border-orange-200 bg-white shadow-sm","children":["$","nav",null,{"className":"max-w-6xl mx-auto px-4 py-4 flex justify-between items-center","children":[["$","h1",null,{"className":"text-2xl font-bold text-orange-700","children":"Petrochemical NDT Hub"}],["$","div",null,{"className":"flex gap-6 text-sm","children":[["$","a",null,{"href":"/","className":"text-orange-600 hover:text-orange-800","children":"Home"}],["$","a",null,{"href":"/processes","className":"text-orange-600 hover:text-orange-800","children":"Processes"}],["$","a",null,{"href":"/equipment","className":"text-orange-600 hover:text-orange-800","children":"Equipment"}],["$","a",null,{"href":"/safety","className":"text-orange-600 hover:text-orange-800","children":"Safety"}]]}]]}]}],["$","main",null,{"className":"min-h-screen max-w-6xl mx-auto px-4 py-12","children":["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"ce