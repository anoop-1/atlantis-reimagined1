0:["DtEt46fChl6XbUZ2NAx2k",[[["",{"children":["methods",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["methods",{"children":["__PAGE__",{},[["$L1",["$","div",null,{"children":[["$","h1",null,{"className":"text-4xl font-bold text-teal-800 mb-8","children":"Advanced Inspection Methods"}],["$","article",null,{"className":"prose prose-lg max-w-none","children":[["$","section",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-2xl font-bold text-teal-800 mb-4","children":"Intelligent Pigging Technologies"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":"Intelligent pigging represents the most comprehensive approach to in-service pipeline assessment. Smart pigs combine multiple sensor technologies within a single tool, traveling internally through the pipeline while operators maintain external control and data collection. This methodology enables inspection of long pipeline segments without service interruption, making it economically viable for extensive networks."}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":"Ultrasonic array pigs use multiple transducers operating at high frequencies (typically 5-10 MHz) to achieve wall thickness measurements with accuracy of ±0.25mm across the entire pipeline circumference. These instruments simultaneously detect metal loss corrosion, external corrosion, and coating defects. Magnetic flux leakage (MFL) pigs saturate pipeline steel with magnetic field and measure flux leakage to identify ferrous material discontinuities including corrosion and crack-like defects. The dual-capability approach ensures detection of defects regardless of orientation or morphology."}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":["Modern pigs incorporate GPS location systems, gyroscopes, and accelerometers to precisely map defect locations within millimeter accuracy. This data enables operators to recover and inspect specific sections with targeted external examination. ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-teal-600 hover:text-teal-800 font-semibold","children":"NDT training programs"}]," specific to pigging operations prepare personnel for managing complex inspection projects across diverse pipeline geometries and environmental conditions."]}]]}],["$","section",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-2xl font-bold text-teal-800 mb-4","children":"Ultrasonic Testing Applications"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":"Phased array ultrasonic testing (PAUT) has revolutionized pipeline inspection capability. By electronically controlling multiple transducers, PAUT achieves rapid scanning of large areas with superior defect characterization. Operators can simultaneously measure wall thickness, detect volumetric defects, and characterize planar anomalies without repositioning equipment. The technique proves particularly valuable for inspecting complex geometries including elbows, tees, and reducers where conventional ultrasonic methods struggle."}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":"Time-of-flight diffraction (TOFD) complements phased array approaches by providing three-dimensional defect imaging and precise depth measurement of crack-like defects. TOFD's superior sensitivity to small cracks makes it the reference standard for validation of other ultrasonic results. Full matrix capture (FMC) combined with total focusing method (TFM) processing represents the latest advancement, achieving near-imaging quality with simple transducer arrays. These advanced techniques enable confident assessment of complex indications and support defensible accept-or-repair decisions."}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":["Long-range guided wave ultrasonics enable rapid screening of long pipeline sections from a single location. By launching ultrasonic waves that propagate along the pipeline wall, this method can scan hundreds of meters in minutes, identifying general areas of concern for detailed investigation. ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-teal-600 hover:text-teal-800 font-semibold","children":"NDT consulting services"}]," leverage guided wave screening to optimize inspection efficiency and reduce overall assessment costs."]}]]}],["$","section",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-2xl font-bold text-teal-800 mb-4","children":"Radiography and Surface Methods"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":"Radiographic examination provides the most defensible evidence of internal and external weld quality. Digital radiography systems offer significant advantages over traditional film, including real-time image review, enhanced contrast manipulation, and reduced personnel exposure. Computed radiography and direct digital radiography continue improving sensitivity-to-unsharpness ratios, enabling detection of finer defects and improved acceptance of high-quality welds."}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":"Magnetic particle inspection (MPI) excels at surface and near-surface defect detection, achieving sensitivities unmatched by other methods. For pipeline girth welds and fabrication flaws, MPI provides rapid, cost-effective screening with excellent probability of detection for cracks and similar defects. Eddy current testing complements MPI by detecting surface defects in non-ferrous materials and measuring coating thickness on ferrous pipelines."}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":["Visual inspection and dye penetrant testing provide low-cost alternatives for accessible areas, particularly for new construction inspection and routine maintenance examinations. While less sensitive than advanced methods, these techniques serve critical quality control functions and often reveal indications of manufacturing processes or handling damage. ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-teal-600 hover:text-teal-800 font-semibold","children":"Digital twin solutions"}]," integrate inspection data from diverse methodologies to provide comprehensive asset condition understanding."]}]]}],["$","section",null,{"children":[["$","h2",null,{"className":"text-2xl font-bold text-teal-800 mb-4","children":"Emerging Techniques and Technologies"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":"Volumetric imaging techniques including phased array and conventional ultrasonics are giving way to advanced signal processing algorithms that enhance image quality and automate defect detection. Machine learning systems trained on extensive defect libraries now augment human interpreters, improving consistency and reducing fatigue-related errors in extended inspection campaigns. Automated scanning systems robotically traverse pipeline surfaces, eliminating manual placement variability and enabling higher-confidence results."}],["$","p",null,{"className":"text-gray-700 leading-relaxed","children":["Advanced sizing techniques for crack-like defects continue improving, with recent development of sophisticated ultrasonic methods capable of measuring crack depth to within 10% of actual dimensions. Probability of detection studies document performance improvements achieved through technological advancement and procedural optimization. ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-teal-600 hover:text-teal-800 font-semibold","children":"Atlantis NDT"}]," continues investing in emerging methodologies to maintain the highest detection standards for critical pipeline applications."]}]]}]]}]]}],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","methods","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/ded4f222e27fbfda.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","children":["$","body",null,{"className":"bg-gradient-to-b from-teal-50 to-white","children":[["$","script",null,{"async":true,"src":"https://www.googletagmanager.com/gtag/js?id=G-1EF92RXSVR"}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"\n        window.dataLayer = window.dataLayer || [];\n        function gtag(){dataLayer.push(arguments);}\n        gtag('js', new Date());\n        gtag('config', 'G-1EF92RXSVR');\n      "}}],["$","header",null,{"className":"border-b border-teal-200 bg-white shadow-sm","children":["$","nav",null,{"className":"max-w-6xl mx-auto px-4 py-4 flex justify-between items-center","children":[["$","h1",null,{"className":"text-2xl font-bold text-teal-700","children":"Pipeline Integrity Guide"}],["$","div",null,{"className":"flex gap-6 text-sm","children":[["$","a",null,{"href":"/","className":"text-teal-600 hover:text-teal-800","children":"Home"}],["$","a",null,{"href":"/methods","className":"text-teal-600 hover:text-teal-800","children":"Methods"}],["$","a",null,{"href":"/standards","className":"text-teal-600 hover:text-teal-800","children":"Standards"}],["$","a",null,{"href":"/case-studies","className":"text-teal-600 hover:text-teal-800","children":"Case Studies"}]]}]]}]}],["$","main",null,{"className":"min-h-screen max-w-6xl mx-auto px-4 py-12","children":["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined