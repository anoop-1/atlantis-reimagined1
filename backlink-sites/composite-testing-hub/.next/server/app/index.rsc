0:["iIdS9PHhV4xBWmFfgsrdc",[[["",{"children":["__PAGE__",{}]},"$undefined","$undefined",true],["",{"children":["__PAGE__",{},[["$L1",["$","div",null,{"className":"space-y-8","children":[["$","section",null,{"className":"bg-purple-50 p-8 rounded-lg","children":[["$","h1",null,{"className":"text-4xl font-bold text-purple-900 mb-4","children":"Composite Materials NDT"}],["$","p",null,{"className":"text-lg text-purple-800","children":"Advanced inspection techniques for fiber-reinforced composites, damage detection, and quality assurance."}]]}],["$","section",null,{"className":"prose max-w-none","children":[["$","h2",null,{"className":"text-2xl font-bold mb-4","children":"Composite Materials in Modern Engineering"}],["$","p",null,{"className":"mb-4","children":"Composite materials—fibers embedded in resin matrices—dominate modern aerospace, wind energy, sporting goods, and automotive applications. Their exceptional strength-to-weight ratios enable lighter structures consuming less energy. Despite advantages, composites present inspection challenges. Damage from impact, environmental exposure, or manufacturing defects may be invisible externally while compromising structural integrity internally."}],["$","p",null,{"className":"mb-4","children":["Aircraft manufacturers rely on comprehensive composite inspection preventing in-flight failures. Wind turbine operators employ NDT monitoring extending blade life and preventing catastrophic failures. Automotive manufacturers use NDT during production ensuring consistent quality. Organizations implementing advanced composite inspection through ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-purple-600 hover:underline","children":"Atlantis NDT"}]," expertise maximize structural reliability and safety."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Composite Damage Mechanisms"}],["$","p",null,{"className":"mb-4","children":"Composite damage takes forms vastly different from metallic failure. Impact creates matrix cracking and fiber breakage while appearing as minor surface damage. Delamination—separation between layers—weakens structures while remaining invisible from external view. Fiber waviness, resin-rich zones, and fiber misalignment from manufacturing reduce properties. Environmental exposure causes resin degradation, moisture absorption, and matrix weakening."}],["$","p",null,{"className":"mb-4","children":["Understanding damage mechanisms informs inspection strategy. Impact damage assessment requires through-thickness examination. Delamination detection requires methods sensitive to bond-line condition. Manufacturing defect detection requires volumetric imaging. Professional training through ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-purple-600 hover:underline","children":"advanced training programs"}]," develops expertise in composite-specific challenges."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Ultrasonic Inspection Excellence"}],["$","p",null,{"className":"mb-4","children":"Ultrasonic testing represents the primary NDT method for composite inspection. Sound waves propagate through composites; reflections from layer interfaces and defects create detectable echoes. C-scan imaging—cross-sectional maps of ultrasonic responses—visually displays damage location and extent. Through-transmission ultrasonic testing detects material loss and damage reducing acoustic transmission."}],["$","p",null,{"className":"mb-4","children":["Phased array ultrasonic systems enable advanced composite inspection. Electronic beam steering enables rapid scanning and flexible inspection angles. Automated systems scan entire composite structures, producing comprehensive damage maps. Integration with ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-purple-600 hover:underline","children":"digital solutions"}]," enables trend monitoring and predictive maintenance."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Thermography and Thermal Methods"}],["$","p",null,{"className":"mb-4","children":"Infrared thermography detects subsurface composite damage through thermal signatures. Delaminations and voids conduct heat differently than solid material, creating temperature variations visible on thermal images. Active thermography—applying controlled heating and monitoring thermal response—enables systematic defect detection across large areas rapidly. The non-contact method works in environments where contact-based testing proves impractical."}],["$","p",null,{"className":"mb-4","children":["Thermography excels at rapid screening, identifying problem areas requiring detailed investigation. Integration with automated data analysis enables consistent interpretation. Organizations deploying thermographic composite inspection through ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-purple-600 hover:underline","children":"expert consultation"}]," achieve efficient defect detection."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Acoustic Emission Monitoring"}],["$","p",null,{"className":"mb-4","children":"Acoustic emission (AE) testing monitors stress-related sounds released during composite loading. As cracks propagate or fibers fracture, acoustic energy releases, detected by sensitive microphones. AE testing monitors in-service composites during operational loading, detecting developing damage in real-time. Portable systems enable field monitoring of critical structures without stopping operations."}],["$","p",null,{"className":"mb-4","children":["AE monitoring enables condition-based maintenance—performing inspections when monitoring indicates developing problems rather than on predetermined schedules. Integration with ",["$","a",null,{"href":"https://ndt-connect.com","rel":"noopener","className":"text-purple-600 hover:underline","children":"monitoring platforms"}]," enables automated alerts when damage indicators exceed thresholds."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Manufacturing Quality Assurance"}],["$","p",null,{"className":"mb-4","children":"Composite manufacturing quality directly affects final product properties. Voids, fiber misalignment, and resin-rich regions reduce properties. Systematic in-process inspection prevents defects from propagating through production. Ultrasonic scanning of manufacturing stages detects problems early when correction costs least. Statistical process control based on inspection results guides parameter optimization."}],["$","p",null,{"className":"mb-4","children":["Organizations implementing comprehensive manufacturing inspection through ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-purple-600 hover:underline","children":"quality systems"}]," achieve superior final product quality and consistent performance."]}]]}]]}],null],null],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/22f1464ebafd7828.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","children":["$","body",null,{"className":"bg-white text-gray-900","children":[["$","script",null,{"async":true,"src":"https://www.googletagmanager.com/gtag/js?id=G-1EF92RXSVR"}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"\n        window.dataLayer = window.dataLayer || [];\n        function gtag(){dataLayer.push(arguments);}\n        gtag('js', new Date());\n        gtag('config', 'G-1EF92RXSVR');\n      "}}],["$","header",null,{"className":"bg-purple-600 text-white","children":["$","nav",null,{"className":"max-w-6xl mx-auto px-6 py-4 flex justify-between items-center","children":[["$","h1",null,{"className":"text-2xl font-bold","children":"Composite Testing Hub"}],["$","div",null,{"className":"space-x-6","children":[["$","a",null,{"href":"/","className":"hover