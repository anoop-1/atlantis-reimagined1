0:["_rnHrAQi-ZzdSdWHlcyOm",[[["",{"children":["underground",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["underground",{"children":["__PAGE__",{},[["$L1",["$","div",null,{"children":[["$","h1",null,{"className":"text-4xl font-bold text-amber-800 mb-8","children":"Underground Storage Tank Inspection"}],["$","article",null,{"className":"prose prose-lg max-w-none","children":[["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":"Underground storage tanks (UST) present unique inspection challenges. Tanks are buried in soil with external surfaces inaccessible for direct inspection. Soil corrosivity affects external tank wall condition. Groundwater presence accelerates external corrosion. Internal corrosion from stored products adds to external degradation. Most USTs operate beyond their design life with uncertain remaining integrity."}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":["Excavation for inspection enables direct assessment of tank external condition, but proves expensive and disruptive. Non-invasive approaches including electromagnetic inspection systems evaluate tank integrity without excavation. ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-amber-600 hover:text-amber-800 font-semibold","children":"NDT training programs"}]," prepare inspectors for UST assessment methodologies adapted to buried tank configurations."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":["Regulatory programs including EPA UST rules establish compliance deadlines for tank replacement or assessment. ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-amber-600 hover:text-amber-800 font-semibold","children":"NDT consulting services"}]," help facility owners develop defensible strategies for managing aging UST fleets while meeting regulatory requirements."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed","children":"Many facility owners address UST risks through replacement with new compliant tanks or closure of unused storage. Comprehensive inventory and condition assessment enable prioritized remediation planning aligned with facility decommissioning or renewal strategies."}]]}]]}],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","underground","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/9b440426e4c89ef2.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","children":["$","body",null,{"className":"bg-gradient-to-b from-amber-50 to-white","children":[["$","script",null,{"async":true,"src":"https://www.googletagmanager.com/gtag/js?id=G-1EF92RXSVR"}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"\n        window.dataLayer = window.dataLayer || [];\n        function gtag(){dataLayer.push(arguments);}\n        gtag('js', new Date());\n        gtag('config', 'G-1EF92RXSVR');\n      "}}],["$","header",null,{"className":"border-b border-amber-200 bg-white shadow-sm","children":["$","nav",null,{"className":"max-w-6xl mx-auto px-4 py-4 flex justify-between items-center","children":[["$","h1",null,{"className":"text-2xl font-bold text-amber-700","children":"Tank Inspection Resource"}],["$","div",null,{"className":"flex gap-6 text-sm","children":[["$","a",null,{"href":"/","className":"text-amber-600 hover:text-amber-800","children":"Home"}],["$","a",null,{"href":"/above-ground","className":"text-amber-600 hover:text-amber-800","children":"Above-Ground"}],["$","a",null,{"href":"/underground","className":"text-amber-600 hover:text-amber-800","children":"Underground"}],["$","a",null,{"href":"/maintenance","classN