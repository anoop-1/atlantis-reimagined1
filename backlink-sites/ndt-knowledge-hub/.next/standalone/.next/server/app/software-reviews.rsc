5:[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"charSet":"utf-8"}],["$","title","2",{"children":"NDT Software Solutions | Reporting, ERP & Digital Twins | NDT Knowledge Hub"}],["$","meta","3",{"name":"description","content":"Comprehensive guide to NDT software landscape including ERP systems, NDTConnect platform, digital twins, and advanced reporting tools for the nondestructive testing industry."}],["$","meta","4",{"name":"keywords","content":"NDT software, ERP systems, digital twins, NDT reporting software, asset integrity management"}],["$","meta","5",{"name":"robots","content":"index, follow"}],["$","meta","6",{"name":"google-site-verification","content":"dlNM5ly7deh5YYSr3uXXCL_lyNXxdluY229Ywzm34nE"}],["$","meta","7",{"property":"og:title","content":"NDT Software Solutions | Reporting, ERP & Digital Twins | NDT Knowledge Hub"}],["$","meta","8",{"property":"og:description","content":"Comprehensive guide to NDT software landscape including ERP systems, NDTConnect platform, digital twins, and advanced reporting tools for the nondestructive testing industry."}],["$","meta","9",{"property":"og:site_name","content":"NDT Knowledge Hub"}],["$","meta","10",{"property":"og:locale","content":"en_US"}],["$","meta","11",{"property":"og:type","content":"website"}],["$","meta","12",{"name":"twitter:card","content":"summary"}],["$","meta","13",{"name":"twitter:title","content":"NDT Software Solutions | Reporting, ERP & Digital Twins | NDT Knowledge Hub"}],["$","meta","14",{"name":"twitter:description","content":"Comprehensive guide to NDT software landscape including ERP systems, NDTConnect platform, digital twins, and advanced reporting tools for the nondestructive testing industry."}]]
