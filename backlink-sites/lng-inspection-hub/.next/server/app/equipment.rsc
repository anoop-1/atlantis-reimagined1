0:["ffZh2beM8ZrwX7uhHW0T5",[[["",{"children":["equipment",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["equipment",{"children":["__PAGE__",{},[["$L1",["$","div",null,{"children":[["$","h1",null,{"className":"text-4xl font-bold text-sky-800 mb-8","children":"LNG Process Equipment"}],["$","article",null,{"className":"prose prose-lg max-w-none","children":[["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":"LNG regasification systems convert cryogenic liquid to ambient temperature gas. Heat exchange equipment transfers thermal energy from warm seawater or other sources to LNG, providing necessary heat for vaporization. Brazed aluminum plate-fin heat exchangers dominate LNG service due to superior thermal efficiency and compact design. NDT assessment of these specialized heat exchangers requires understanding of brazing metallurgy and cryogenic material properties."}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":["Pumps and compressors operating in cryogenic service experience seal challenges and bearing degradation from extreme temperature conditions. ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-sky-600 hover:text-sky-800 font-semibold","children":"Digital twin solutions"}]," track equipment operating hours, thermal cycling events, and historical failure patterns to predict maintenance requirements. Predictive maintenance based on equipment condition monitoring extends useful life while preventing unexpected failures."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":"Instrumentation and control systems monitoring LNG facility operations must maintain reliability during thermal cycling and extreme environmental exposure. Thermocouple integrity, pressure transmitter accuracy, and level measurement system function require periodic verification. NDT inspection of instrumentation sensing elements confirms continued operational reliability."}],["$","p",null,{"className":"text-gray-700 leading-relaxed","children":"Comprehensive equipment inspection programs ensure continued reliable operation of specialized LNG processing systems, maintaining competitive operational efficiency in global LNG markets."}]]}]]}],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","equipment","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/53b677acd480dc38.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","children":["$","body",null,{"className":"bg-gradient-to-b from-sky-50 to-white","children":[["$","script",null,{"async":true,"src":"https://www.googletagmanager.com/gtag/js?id=G-1EF92RXSVR"}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"\n        window.dataLayer = window.dataLayer || [];\n        function gtag(){dataLayer.push(arguments);}\n        gtag('js', new Date());\n        gtag('config', 'G-1EF92RXSVR');\n      "}}],["$","header",null,{"className":"border-b border-sky-200 bg-white shadow-sm","children":["$","nav",null,{"className":"max-w-6xl mx-auto px-4 py-4 flex justify-between items-center","children":[["$","h1",null,{"className":"text-2xl font-bold text-sky-700","children":"LNG Inspection Hub"}],["$","div",null,{"className":"flex gap-6 text-sm","children":[["$","a",null,{"href":"/","className":"text-sky-600 hover:text-sky-800","children":"Home"}],["$","a",null,{"href":"/terminals","className":"text-sky-600 hover:text-sky-800","children":"Terminals"}],["$","a",null,{"href":"/equipment","className":"text-sky-600 hover:text-sky-800","children":"Equipment"}],["$","a",null,{"href":"/safety","className":"text-sky-600 hover:text-sky-800","childre