0:["8KjyS7Fr0XV23qcF5SMc9",[[["",{"children":["__PAGE__",{}]},"$undefined","$undefined",true],["",{"children":["__PAGE__",{},[["$L1",["$","div",null,{"children":[["$","div",null,{"className":"bg-gradient-to-r from-green-600 to-green-400 text-white p-12 rounded-lg mb-12","children":[["$","h1",null,{"className":"text-4xl font-bold mb-4","children":"Renewable Energy Integrity Assurance"}],["$","p",null,{"className":"text-lg text-green-100","children":"NDT Solutions for Clean Energy Infrastructure"}]]}],["$","article",null,{"className":"prose prose-lg max-w-none mb-12","children":[["$","section",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-2xl font-bold text-green-800 mb-4","children":"NDT in Renewable Energy Transition"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":"Renewable energy infrastructure represents rapidly expanding global investment in wind, solar, geothermal, and hydroelectric systems. These systems replace conventional fossil fuel power generation, requiring reliable 20-30 year operating life with minimal maintenance interventions. Non-destructive testing enables operators to maintain equipment integrity and operational availability throughout extended service lives while minimizing unplanned maintenance costs."}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":"Wind turbines, solar installations, and geothermal systems operate in challenging environments including coastal salt spray, extreme temperature variations, seismic regions, and corrosive chemical exposure. Materials and equipment designed for these demanding service conditions require periodic assessment ensuring continued safe, economical operation. Modern NDT approaches optimize inspection frequency and extent based on component criticality and failure consequence severity."}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":[["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-green-600 hover:text-green-800 font-semibold","children":"NDT consulting services"}]," specialized in renewable energy applications bring understanding of equipment failure mechanisms and industry-specific inspection requirements. ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-green-600 hover:text-green-800 font-semibold","children":"NDT training programs"}]," prepare personnel for renewable energy system assessment."]}]]}],["$","section",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-2xl font-bold text-green-800 mb-4","children":"Wind Turbine System Assessment"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":["Wind turbine generators, gearboxes, and structural components experience cyclic loading from wind pressure variations and vibration. Fatigue crack initiation in welded structures and bearing wear represent typical degradation mechanisms. Blade integrity assessment detects delamination and matrix cracking in composite materials. ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-green-600 hover:text-green-800 font-semibold","children":"Ultrasonic testing"}]," assesses internal blade condition. Thermography identifies delamination zones indicating composite material degradation."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":["Gearbox oil analysis combined with visual inspection and vibration monitoring detects emerging wear patterns before catastrophic failures occur. Bearing condition assessment through vibration analysis and thermography enables predictive maintenance replacing components before failures interrupt electricity generation. ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-green-600 hover:text-green-800 font-semibold","children":"Digital twin solutions"}]," integrate turbine operational data with predictive models enabling optimal maintenance scheduling."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":"Foundation and structural assessment ensures that tower structures and connection systems maintain integrity under extreme loading. Magnetic particle examination of critical welds confirms connection quality. Radiographic inspection of welds provides definitive quality documentation. Systematic NDT programs prevent catastrophic failures that could damage surrounding infrastructure and interrupt electricity supply."}]]}],["$","section",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-2xl font-bold text-green-800 mb-4","children":"Solar and Geothermal System Integrity"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":"Concentrated solar power systems employ heat transfer fluids carrying thermal energy from heliostats to power conversion equipment. Piping system integrity is essential to maintain heat transfer efficiency and prevent catastrophic fluid loss. Wall thickness measurement via ultrasonics identifies corrosion from fluid exposure. Pressure testing confirms structural adequacy. Advanced heat transfer fluids at high temperatures create unique material degradation challenges requiring specialized assessment approaches."}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":["Geothermal systems accessing subsurface heat extract thermal energy from earth's interior through deep wells and heat exchanger systems. Well integrity assessment ensures containment of geothermal fluid within designed boundaries. ",["$","a",null,{"href":"https://ndt-connect.com","rel":"noopener","className":"text-green-600 hover:text-green-800 font-semibold","children":"NDTConnect platform"}]," centralizes inspection documentation for distributed renewable energy facilities."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed","children":"Comprehensive NDT programs for renewable energy systems ensure continued reliable generation of clean energy. Investment in inspection capabilities demonstrates environmental stewardship and operational commitment to sustainable energy production for future generations."}]]}]]}]]}],null],null],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/0ee9757eebbd62cd.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","children":["$","body",null,{"className":"bg-gradient-to-b from-green-50 to-white","children":[["$","script",null,{"async":true,"src":"https://www.googletagmanager.com/gtag/js?id=G-1EF92RXSVR"}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"\n        window.dataLayer = window.dataLayer || [];\n        function gtag(){dataLayer.push(arguments);}\n        gtag('js', new Date());\n        gtag('config', 'G-1EF92RXSVR');\n      "}}],["$","header",null,{"className":"border-b border-green-200 bg-white shadow-sm","children":["$","nav",null,{"className":"max-w-6xl mx-auto px-4 py-4 flex justify-between items-center","children":[["$","h1",null,{"className":"text-2xl font-bold text-green-700","children":"Renewable Energy NDT"}],["$","div",null,{"className":"flex gap-6 text-sm","children":[["$","a",null,{"href":"/","className":"text-green-600 hover:text-green-800","children":"Home"}],["$","a",null,{"href":"/wind","className":"text-green-600 hover:text-green-800","children":"Wind Energy"}],["$","a",null,{"href":"/solar","className":"text-green-600 hover:text-green-800","children":"Solar"}],["$","a",null,{"href":"/geothermal","className":"text-green-600 hover:text-green-800","children":"Geothermal"}]]}]]}]}],["$","main",null,{"className":"min-h-screen max-w-6xl mx-auto px-4 py-12","children":["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","title",null,{"children":"404: Th