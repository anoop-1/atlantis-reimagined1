0:["Mo2-XkSun1FejE4_s5uMy",[[["",{"children":["certification",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["certification",{"children":["__PAGE__",{},[["$L1",["$","div",null,{"children":[["$","h1",null,{"className":"text-4xl font-bold text-cyan-800 mb-8","children":"Subsea Inspection Certification"}],["$","article",null,{"className":"prose prose-lg max-w-none","children":[["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":["Offshore NDT operations require personnel with specialized qualifications beyond standard land-based certifications. Offshore survival training, safety induction, and vessel familiarization represent prerequisites for all offshore work. NDT certification standards including ASNT and PCN establish baseline competency requirements applicable universally, while additional offshore-specific qualifications address unique operational challenges. ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-cyan-600 hover:text-cyan-800 font-semibold","children":"NDT training programs"}]," incorporate offshore-specific modules preparing personnel for marine environment operations."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":["Equipment certification for offshore deployment includes qualification testing demonstrating functionality under expected operational conditions. Ultrasonic transducers must maintain performance in seawater environments, while radiographic and eddy current systems require environmental protection. ",["$","a",null,{"href":"https://ndt-connect.com","rel":"noopener","className":"text-cyan-600 hover:text-cyan-800 font-semibold","children":"NDTConnect platform"}]," tracks equipment maintenance, calibration, and certification status ensuring readiness for offshore campaigns."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":["Quality assurance programs for offshore inspection must address unique challenges including communication delays between surface and ROV operations, limited visibility in zero-transparency conditions, and pressure on schedule adherence to minimize vessel time costs. Procedures must balance thoroughness with operational efficiency. ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-cyan-600 hover:text-cyan-800 font-semibold","children":"NDT consulting services"}]," develop efficient inspection strategies optimizing subsea assessment reliability."]}],["$","p",null,{"className":"text-gray-700 leading-relaxed","children":"Certification frameworks for subsea NDT continue evolving as offshore operations extend into deeper waters and more challenging environments. Maintaining technical competency and equipment capability as operations boundaries expand requires commitment to continuous professional development and technology advancement."}]]}]]}],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","certification","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/00aab175a209a732.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","children":["$","body",null,{"className":"bg-gradient-to-b from-cyan-50 to-white","children":[["$","script",null,{"async":true,"src":"https://www.googletagmanager.com/gtag/js?id=G-1EF92RXSVR"}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"\n        window.dataLayer = window.dataLayer || [];\n        function gtag(){dataLayer.push(arguments);}\n        gtag('js', new Date());\n        gtag('config', 'G-1EF92RXSVR');\n      "}}],["$","header",null,{"className":"border-b border-cyan-200 bg-white shadow-sm","children":["$","nav",null,{"classN