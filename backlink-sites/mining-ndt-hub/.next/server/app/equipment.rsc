0:["5M_laxXAjH5dplDMc0GUP",[[["",{"children":["equipment",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["equipment",{"children":["__PAGE__",{},[["$L1",["$","div",null,{"className":"space-y-8","children":[["$","section",null,{"className":"bg-yellow-50 p-8 rounded-lg","children":[["$","h1",null,{"className":"text-3xl font-bold text-yellow-900 mb-2","children":"Equipment Inspection"}],["$","p",null,{"className":"text-yellow-800","children":"NDT methods for mining equipment condition assessment."}]]}],["$","section",null,{"className":"prose max-w-none","children":[["$","h2",null,{"className":"text-2xl font-bold mb-4","children":"Excavator and Shovel Inspection"}],["$","p",null,{"className":"mb-4","children":"Excavators and shovels endure extreme cyclic loading from digging operations. Fatigue cracks develop in bucket teeth, boom structures, and hydraulic systems. Ultrasonic testing detects fatigue cracks in welded joints. Eddy current testing identifies surface cracks in structural members. Thermographic inspection monitors hydraulic system temperatures."}],["$","p",null,{"className":"mb-4","children":["Systematic monitoring prevents catastrophic failures that could strand equipment or injure operators. Professional inspection through ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-yellow-700 hover:underline","children":"NDT training programs"}]," ensures effective defect detection and safe operation decisions."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Haul Truck Assessment"}],["$","p",null,{"className":"mb-4","children":"Mining haul trucks operate continuously in harsh conditions, carrying heavy loads over rough terrain. Structural fatigue, suspension wear, and tire degradation require monitoring. Ultrasonic testing assesses frame and attachment weld integrity. Thickness measurement tracks wear of brake components and hydraulic systems. Bearing condition monitoring predicts maintenance needs."}],["$","p",null,{"className":"mb-4","children":["Integration with ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-yellow-700 hover:underline","children":"NDT consulting services"}]," supports development of effective haul truck inspection programs maximizing fleet reliability."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Conveyor System Monitoring"}],["$","p",null,{"className":"mb-4","children":"Conveyor systems transport extracted ore continuously. Bearing failures, idler degradation, and belt wear reduce efficiency and cause downtime. Thermography detects bearing overheating before failure. Ultrasonic testing assesses bearing condition. Belt inspection systems identify wear requiring replacement."}],["$","p",null,{"className":"mb-4","children":["Automated monitoring systems continuously assess conveyor condition, alerting maintenance to developing problems. Integration with ",["$","a",null,{"href":"https://ndt-connect.com","rel":"noopener","className":"text-yellow-700 hover:underline","children":"NDTConnect platform"}]," enables proactive maintenance scheduling minimizing production disruption."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Crusher and Mill Inspection"}],["$","p",null,{"className":"mb-4","children":"Crushing and milling equipment operates at extremely high loads. Bearing failures, liner wear, and structural fatigue threaten equipment life and safety. Vibration analysis detects bearing degradation. Thermography identifies overheating. Ultrasonic assessment of welds ensures structural integrity. Regular inspection enables planned maintenance minimizing unexpected downtime."}],["$","p",null,{"className":"mb-4","children":["Organizations implementing comprehensive crusher monitoring through ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-yellow-700 hover:underline","children":"NDT ERP software"}]," achieve exceptional equipment reliability and productivity."]}]]}]]}],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","equipment","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/18d37cc4b0289d79.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","children":["$","body",null,{"className":"bg-white text-gray-900","children":[["$","script",null,{"async":true,"src":"https://www.googletagmanager.com/gtag/js?id=G-1EF92RXSVR"}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"\n        window.dataLayer = window.dataLayer || [];\n        function gtag(){dataLayer.push(arguments);}\n        gtag('js', new Date());\n        gtag('config', 'G-1EF92RXSVR');\n      "}}],["$","header",null,{"className":"bg-yellow-600 text-white","children":["$","nav",null,{"className":"max-w-6xl mx-auto px-6 py-4 flex justify-between items-center","children":[["$","h1",null,{"className":"text-2xl font-bold","children":"Mining NDT Hub"}],["$","div",null,{"className":"space-x-6","children":[["$","a",null,{"href":"/","className":"hover:text-yellow-200","children":"Home"}],["$","a",null,{"href":"/equipment","className":"hover:text-yellow-200","children":"Equipment"}],["$","a",null,{"href":"/safety","className":"hover:text-yellow-200","children":"Safety"}],["$","a",null,{"href":"/maintenance","className":"hover:text-yellow-200","children":"Maintenance"}]]}]]}]}],["$","main",null,{"className":"max-w-6xl mx-auto px-6 py-12","children":["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","template