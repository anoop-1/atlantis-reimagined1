0:["k4sqyxlooEvPYccLIMdsw",[[["",{"children":["methods",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["methods",{"children":["__PAGE__",{},[["$L1",["$","div",null,{"className":"space-y-8","children":[["$","section",null,{"className":"bg-gray-100 p-8 rounded-lg","children":[["$","h1",null,{"className":"text-3xl font-bold text-gray-900 mb-2","children":"Inspection Methods"}],["$","p",null,{"className":"text-gray-700","children":"NDT techniques specifically applied to railway component inspection."}]]}],["$","section",null,{"className":"prose max-w-none","children":[["$","h2",null,{"className":"text-2xl font-bold mb-4","children":"Ultrasonic Testing for Wheels"}],["$","p",null,{"className":"mb-4","children":"Automated ultrasonic wheel scanners installed trackside perform instantaneous inspection as trains pass at operating speed. Transducers mounted on spring-loaded arms contact wheel treads and flanges, generating ultrasonic pulses that penetrate wheel material. Internal reflections reveal cracks, seams, and material anomalies. A/scan data processes through algorithms detecting specific defect signatures, automatically classifying wheel conditions."}],["$","p",null,{"className":"mb-4","children":["Modern systems inspect multiple wheels per train simultaneously, capturing complete fleet data continuously. Results integrate with maintenance systems, automatically scheduling wheel removal when defects exceed safe limits. ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-gray-700 hover:underline","children":"Professional training"}]," ensures inspectors understand ultrasonic principles and system capabilities."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Eddy Current Rail Head Inspection"}],["$","p",null,{"className":"mb-4","children":"Eddy current array probes scan rail heads, detecting subsurface fatigue cracks. Arrays of multiple small coils enable electronic scanning across rail width without mechanical movement. High-speed systems inspect rails at normal operational speed, capturing complete rail head scans. Crack depth and length classification enables risk assessment and maintenance prioritization."}],["$","p",null,{"className":"mb-4","children":["Eddy current inspection integrates with track geometry measurement systems, providing comprehensive track condition assessment. Where geometry shows stress concentration, eddy current closely examines for developing cracks. Integration with ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-gray-700 hover:underline","children":"digital twin solutions"}]," enables predictive maintenance planning."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Magnetic Particle Testing"}],["$","p",null,{"className":"mb-4","children":"Magnetic particle inspection of wheel sets, axles, and bearing components reveals surface and subsurface flaws. Magnetization induces magnetic flux through components; surface-breaking defects disrupt flux, trapping magnetic particles in visible patterns. Portable equipment enables in-service inspection without component removal. Systematic scanning detects fatigue cracks before they propagate to critical lengths."}],["$","p",null,{"className":"mb-4","children":["Organizations implementing ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-gray-700 hover:underline","children":"NDT consulting services"}]," establish effective magnetic particle programs addressing critical component safety requirements."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Acoustic Resonance and Vibration Analysis"}],["$","p",null,{"className":"mb-4","children":"Acoustic resonance methods detect wheel cracks by analyzing vibration signatures. Cracked wheels exhibit distinctive resonance frequencies; algorithms differentiate cracked wheels from normal wheels with high accuracy. Vibration analysis systems mounted trackside capture acoustic signatures from passing wheels, automatically alerting maintenance when defects are detected."}],["$","p",null,{"className":"mb-4","children":["These methods complement ultrasonic inspection, providing redundant detection and offering advantages in certain scenarios. Integration of multiple detection modalities through ",["$","a",null,{"href":"https://ndt-connect.com","rel":"noopener","className":"text-gray-700 hover:underline","children":"NDTConnect platform"}]," ensures comprehensive defect detection."]}]]}]]}],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","methods","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/99b831f832a51c6c.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","children":["$","body",null,{"className":"bg-white text-gray-900","children":[["$","script",null,{"async":true,"src":"https://www.googletagmanager.com/gtag/js?id=G-1EF92RXSVR"}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"\n        window.dataLayer = window.dataLayer || [];\n        function gtag(){dataLayer.push(arguments);}\n        gtag('js', new Date());\n        gtag('config', 'G-1EF92RXSVR');\n      "}}],["$","header",null,{"className":"bg-gray-700 text-white","children":["$","nav",null,{"className":"max-w-6xl mx-auto px-6 py-4 flex justify-between items-center","children":[["$","h1",null,{"className":"text-2xl font-bold","children":"Railway NDT Resource"}],["$","div",null,{"className":"space-x-6","children":[["$","a",null,{"href":"/","className":"hover:text-gray-300","children":"Home"}],["$","a",null,{"href":"/methods","className":"hover:text-gray-300","children":"Met