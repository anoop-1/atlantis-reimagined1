0:["k4sqyxlooEvPYccLIMdsw",[[["",{"children":["wheel-inspection",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["wheel-inspection",{"children":["__PAGE__",{},[["$L1",["$","div",null,{"className":"space-y-8","children":[["$","section",null,{"className":"bg-gray-100 p-8 rounded-lg","children":[["$","h1",null,{"className":"text-3xl font-bold text-gray-900 mb-2","children":"Wheel Inspection Excellence"}],["$","p",null,{"className":"text-gray-700","children":"Comprehensive wheel defect detection and safe operation protocols."}]]}],["$","section",null,{"className":"prose max-w-none","children":[["$","h2",null,{"className":"text-2xl font-bold mb-4","children":"Wheel Defect Classification"}],["$","p",null,{"className":"mb-4","children":"Railway industry standards classify wheel defects by severity and implications for safe operation. Minor surface defects might be monitored through routine inspections. Shelling—surficial fatigue spalling—requires observation to prevent propagation. Tread cracks demand wheel replacement due to derailment risk. Flange cracks pose immediate safety hazards. Systematic classification enables risk-based maintenance prioritization."}],["$","p",null,{"className":"mb-4","children":["Organizations implementing standardized defect classification through ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-gray-700 hover:underline","children":"NDT ERP software"}]," ensure consistent decision-making and safety compliance across their operations."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"In-Service Wheel Inspection Programs"}],["$","p",null,{"className":"mb-4","children":"Modern railways conduct continuous wheel inspection without removing rolling stock from service. Stationary inspection systems mounted at strategic locations scan every wheel passing through the inspection point. The non-contact approach enables high-speed operation with comprehensive data capture. Automated interpretation provides immediate defect notifications, enabling rapid maintenance response."}],["$","p",null,{"className":"mb-4","children":["Successful in-service programs require robust system design, reliable automation, and integration with maintenance scheduling. Expert consultation through ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-gray-700 hover:underline","children":"NDT consulting services"}]," helps organizations design and implement effective programs."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Maintenance and Safe Operation"}],["$","p",null,{"className":"mb-4","children":"Wheel inspection results drive maintenance decisions affecting safety. Wheels exceeding established defect limits must be removed and either repaired or scrapped. Maintenance procedures ensure proper installation and verification of repaired wheels. Operating procedures address special handling of trains with marginal wheels until permanent repairs are completed."}],["$","p",null,{"className":"mb-4","children":["Integration of inspection results with maintenance management systems through ",["$","a",null,{"href":"https://ndt-connect.com","rel":"noopener","className":"text-gray-700 hover:underline","children":"NDTConnect"}]," ensures seamless communication between inspection and maintenance functions."]}]]}]]}],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","wheel-inspection","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/99b831f832a51c6c.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","children":["$","body",null,{"className":"bg-white text-gray-900",