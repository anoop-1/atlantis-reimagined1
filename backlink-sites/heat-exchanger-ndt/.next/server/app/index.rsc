0:["nRd8pHIHaQILh8mpeXvXx",[[["",{"children":["__PAGE__",{}]},"$undefined","$undefined",true],["",{"children":["__PAGE__",{},[["$L1",["$","div",null,{"className":"space-y-8","children":[["$","section",null,{"className":"bg-rose-50 p-8 rounded-lg","children":[["$","h1",null,{"className":"text-4xl font-bold text-rose-900 mb-4","children":"Heat Exchanger NDT"}],["$","p",null,{"className":"text-lg text-rose-800","children":"Specialized inspection techniques for heat exchanger tubes, fouling detection, and degradation assessment."}]]}],["$","section",null,{"className":"prose max-w-none","children":[["$","h2",null,{"className":"text-2xl font-bold mb-4","children":"Heat Exchanger Inspection Challenges"}],["$","p",null,{"className":"mb-4","children":"Heat exchangers operate at extremes—high temperatures, pressures, corrosive fluids, and thermal cycling stress. Tube bundles containing hundreds or thousands of tubes require rapid, reliable inspection. Corrosion, fouling, and erosion degrade heat transfer and structural integrity. Finding defective tubes among hundreds demands systematic, efficient inspection methods. Failures can force production shutdowns affecting millions daily."}],["$","p",null,{"className":"mb-4","children":["Modern heat exchangers span applications from power generation to petrochemicals to HVAC systems. Each application presents unique material, temperature, and corrosion challenges. Professional expertise in heat exchanger assessment through ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-rose-600 hover:underline","children":"Atlantis NDT"}]," consulting enables effective inspection programs."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Eddy Current Tube Testing"}],["$","p",null,{"className":"mb-4","children":"Eddy current testing represents the standard method for heat exchanger tube inspection. Rotating probes inserted into tubes perform rapid scanning detecting wall loss, pitting, stress corrosion cracks, and fouling. Multiple-frequency systems simultaneously assess different defect types. Probe speeds of 1-2 meters/second enable testing hundreds of tubes daily. Automated scanners process thousands of tubes rapidly, producing probability of defect (POD) values indicating inspection reliability."}],["$","p",null,{"className":"mb-4","children":["Eddy current sensitivity to tube material, wall thickness, and condition enables quantitative defect sizing. Results guide decisions about continued service, plugging defective tubes, or scheduling major maintenance. Integration with ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-rose-600 hover:underline","children":"specialized training"}]," develops expert probe operation and data interpretation."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Corrosion and Wall Loss Detection"}],["$","p",null,{"className":"mb-4","children":"Corrosion—gradual material loss from chemical attack—gradually reduces tube wall thickness. Uniform corrosion thins tube walls evenly; localized pitting creates stress concentrations initiating failures at loads below theoretical strength. Eddy current testing quantifies wall loss, enabling corrosion rate calculation. When rates exceed tolerance limits, tubes require replacement before failure."}],["$","p",null,{"className":"mb-4","children":["Systematic corrosion monitoring enables predictive maintenance—replacing tubes before failures occur rather than responding to emergencies. Organizations implementing ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-rose-600 hover:underline","children":"predictive maintenance programs"}]," minimize downtime and extend asset life."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Stress Corrosion Cracking Detection"}],["$","p",null,{"className":"mb-4","children":"Stress corrosion cracking (SCC) occurs when tensile stress, corrosive environment, and susceptible material combine. Cracks propagate at stresses below yield strength, causing sudden failures. In stainless steel tubes, chloride-induced SCC poses significant risk. Eddy current testing detects SCC through characteristic waveforms. Identifying tubes with SCC enables their removal before crack propagation causes tube rupture."}],["$","p",null,{"className":"mb-4","children":["SCC assessment requires experienced personnel understanding material-environment-stress interactions. Professional consultation through ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-rose-600 hover:underline","children":"specialized expertise"}]," helps organizations manage SCC risk effectively."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Fouling and Blockage Assessment"}],["$","p",null,{"className":"mb-4","children":"Fouling—accumulation of deposits on heat transfer surfaces—reduces heat transfer efficiency and traps corrosive fluids against tube walls. Progressive fouling increases corrosion rates and operating costs. Eddy current probes sometimes cannot penetrate heavily fouled tubes, indicating critical fouling. Other methods including mechanical cleaning verification and ultrasonic wall thickness assessment complement eddy current testing."}],["$","p",null,{"className":"mb-4","children":["Fouling management combines inspection with mechanical cleaning. Systematic monitoring through ",["$","a",null,{"href":"https://ndt-connect.com","rel":"noopener","className":"text-rose-600 hover:underline","children":"condition management systems"}]," optimizes cleaning timing, balancing fouling risks with cleaning costs and potential damage."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Ultrasonic Thickness Measurement"}],["$","p",null,{"className":"mb-4","children":"Ultrasonic thickness measurement complements eddy current testing, providing rapid wall loss assessment. Portable ultrasonic thickness gages measure from outside the tube, eliminating internal probe insertion. This method works for tubes that eddy current cannot access due to fouling or obstructions. Systematic measurement at multiple tube locations maps wall loss distribution."}],["$","p",null,{"className":"mb-4","children":["Combined eddy current and ultrasonic approaches ensure comprehensive tube assessment. Organizations implementing multi-method inspection through ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-rose-600 hover:underline","children":"integrated data systems"}]," achieve superior reliability and efficiency."]}]]}]]}],null],null],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/e22ddc497c121944.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","children":["$","body",null,{"className":"bg-white text-gray-900","children":[["$","script",null,{"async":true,"src":"https://www.googletagmanager.com/gtag/js?id=G-1EF92RXSVR"}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"\n        window.dataLayer = window.dataLayer || [];\n        function gtag(){dataLayer.push(arguments);}\n        gtag('js', new Date());\n        gtag('config', 'G-1EF92RXSVR');\n      "}}],["$","header",null,{"className":"bg-rose-600 text-white","children":["$","nav",null,{"className":"max-w-6xl mx-auto px-6 py-4 flex justify-between items-center","children":[["$","h1",null,{"className":"text-2xl font-bold","children":"Heat Exchanger NDT"}],["$","div",null,{"className":"space-x-6","children":[["$","a",null,{"href":"/","className":"hover:text-rose-200","children":"Home"}],["$","a",null,{"href":"/tube-inspection","className":"hover:text-rose-200","children":"Tube Inspection"}],["$","a",null,{"href":"/corrosion-detection","className":"hover:text-rose-200","children":"Corrosion"}],["$","a",null,{"href":"/maintenance","className":"hover:text-rose-200","children":"Maintenance"}]]}]]}]}],["