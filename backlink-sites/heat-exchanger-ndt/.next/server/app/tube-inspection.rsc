0:["nRd8pHIHaQILh8mpeXvXx",[[["",{"children":["tube-inspection",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["tube-inspection",{"children":["__PAGE__",{},[["$L1",["$","div",null,{"className":"space-y-8","children":[["$","section",null,{"className":"bg-rose-50 p-8 rounded-lg","children":[["$","h1",null,{"className":"text-3xl font-bold text-rose-900 mb-2","children":"Tube Inspection Procedures"}],["$","p",null,{"className":"text-rose-800","children":"Systematic approaches to comprehensive heat exchanger tube assessment."}]]}],["$","section",null,{"className":"prose max-w-none","children":[["$","h2",null,{"className":"text-2xl font-bold mb-4","children":"Inspection Planning and Risk Assessment"}],["$","p",null,{"className":"mb-4","children":"Effective inspection programs prioritize resources based on risk. Tubes exposed to corrosive environments receive most frequent inspection. Critical tubes affecting process safety receive priority. High-material-velocity regions experience accelerated degradation requiring attention. Risk-based inspection allocates resources efficiently, ensuring comprehensive assessment of highest-risk areas."}],["$","p",null,{"className":"mb-4","children":["Organizations implementing systematic risk assessment through ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-rose-600 hover:underline","children":"expert programs"}]," optimize inspection scheduling and maintenance investment."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Eddy Current Probe Selection and Operation"}],["$","p",null,{"className":"mb-4","children":"Probe selection depends on tube material, diameter, and wall thickness. Different frequencies optimize sensitivity to various defect types. Bobbin probes perform rapid scanning detecting wall loss. Rotating coil probes achieve better resolution of cracks. Probe speed optimization balances rapid testing with defect detection sensitivity. Proper equipment maintenance and calibration ensure consistent results."}],["$","p",null,{"className":"mb-4","children":["Professional training through ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-rose-600 hover:underline","children":"specialized programs"}]," develops expertise in probe selection and operation."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Data Interpretation and Sizing"}],["$","p",null,{"className":"mb-4","children":"Eddy current data interpretation requires understanding material responses and defect signatures. Corrosion creates characteristic patterns. Cracks produce different signatures. Fouling affects signal amplitude. Experienced inspectors distinguish defects from artifacts, accurately sizing indications. Automated analysis software assists interpretation, but experienced judgment remains critical for complex cases."}],["$","p",null,{"className":"mb-4","children":["Organizations implementing standardized interpretation protocols through ",["$","a",null,{"href":"https://ndt-connect.com","rel":"noopener","className":"text-rose-600 hover:underline","children":"consistent procedures"}]," ensure reliable decisions across inspection teams."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Record Keeping and Trending"}],["$","p",null,{"className":"mb-4","children":"Comprehensive records of all inspections enable trend analysis. Tubes showing corrosion rates exceeding tolerance limits can be plugged before failure. Comparison of current results with historical data reveals accelerating degradation. Statistical analysis guides maintenance scheduling. Long-term records prove invaluable during troubleshooting of performance issues."}],["$","p",null,{"className":"mb-4","children":["Digital record systems through ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-rose-600 hover:underline","children":"NDT ERP systems"}]," enable efficient trending and predictive maintenance."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Quality Assurance and Calibration"}],["$","p",null,{"className":"mb-4","children":"Equipment calibration ensures consistent, reliable results. Reference standards simulating various defect types verify probe performance. Periodic recalibration catches equipment drift affecting accuracy. Personnel qualification through testing and demonstrated competency ensures interpretation reliability. Documentation of all quality measures supports regulatory compliance."}],["$","p",null,{"className":"mb-4","children":["Organizations implementing rigorous quality programs through ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-rose-600 hover:underline","children":"professional oversight"}]," achieve superior reliability and confidence in results."]}]]}]]}],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","tube-inspection","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/e22ddc497c121944.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","children":["$","body",null,{"className":"bg-white text-gray-900","children":[["$","script",null,{"async":true,"src":"https://www.googletagmanager.com/gtag/js?id=G-1EF92RXSVR"}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"\n        window.dataLayer = window.dataLayer || [];\n        function gtag(){dataLayer.push(arguments);}\n        gtag('js', new Date());\n        gtag('config', 'G-1EF92RXSVR');\n      "}}],["$","header",null,{"className":"bg-rose-600 text-white","children":["$","nav",null,{"className":"max-w-6xl mx-auto px-6 py-4 fle