0:["Fu_z655jFMx3hQxb6ojGR",[[["",{"children":["technologies",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["technologies",{"children":["__PAGE__",{},[["$L1",["$","div",null,{"className":"space-y-8","children":[["$","section",null,{"className":"bg-indigo-50 p-8 rounded-lg","children":[["$","h1",null,{"className":"text-3xl font-bold text-indigo-900 mb-2","children":"Automation Technologies"}],["$","p",null,{"className":"text-indigo-800","children":"Core technologies enabling NDT automation and robotics."}]]}],["$","section",null,{"className":"prose max-w-none","children":[["$","h2",null,{"className":"text-2xl font-bold mb-4","children":"Phased Array Ultrasonic Testing"}],["$","p",null,{"className":"mb-4","children":"Phased array ultrasonic testing (PAUT) represents a significant advancement over traditional single-element transducers. Arrays containing dozens or hundreds of small elements allow electronic beam steering, focusing, and scanning without mechanical movement. Automated systems exploit this capability, producing complete volumetric images of components rapidly."}],["$","p",null,{"className":"mb-4","children":["In automated welding inspection, phased array systems scan seams at speeds of 100+ mm/second, detecting planar and volumetric defects with exceptional sensitivity. Electronic focusing adjusts depth dynamically, maintaining resolution across entire component volumes. The systems integrate directly with robotic platforms, enabling hands-free scanning that human operators couldn't replicate. Organizations implementing phased array automation through ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-indigo-600 hover:underline","children":"NDT consulting services"}]," report dramatic improvements in inspection reliability and speed."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Eddy Current Array Systems"}],["$","p",null,{"className":"mb-4","children":"Eddy current array (ECA) technology has evolved from single-coil probes to sophisticated multi-element arrays providing simultaneous coverage of wide areas. Automated ECA systems scan turbine blade surfaces, aircraft fuselages, and heat exchanger tubes with unmatched speed and sensitivity to surface and near-surface defects."}],["$","p",null,{"className":"mb-4","children":["What makes ECA particularly valuable in automated systems is its speed—scanning rates of several meters per second—combined with excellent lift-off tolerance that reduces mechanical requirements. Advanced ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-indigo-600 hover:underline","children":"NDT training programs"}]," now emphasize interpretation of ECA data at scale, preparing technicians for roles managing high-volume automated inspections."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Thermography and Thermal Imaging"}],["$","p",null,{"className":"mb-4","children":"Infrared thermography detects subsurface defects through thermal pattern analysis. Automated thermographic systems, often mounted on drones or robotic arms, scan large surfaces systematically. Active thermography—where systems apply controlled heating and monitor cooling patterns—reveals delaminations, disbonds, and corrosion beneath protective coatings."}],["$","p",null,{"className":"mb-4","children":["Applications span composite aircraft structures, solar panel arrays, electrical equipment, and building envelope assessment. The non-contact nature of thermography makes it ideal for hazardous environment inspection. For comprehensive implementation strategies, ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-indigo-600 hover:underline","children":"digital twin solutions"}]," now incorporate thermal baseline models, enabling precise anomaly detection."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Laser Scanning and Metrology"}],["$","p",null,{"className":"mb-4","children":"3D laser scanning and structured light systems generate precise geometric data. While not strictly NDT in the traditional sense, these technologies complement inspection programs by correlating defect locations with precise geometry. Automated laser scanning systems create point clouds, measure thickness variations, and detect surface deformations."}],["$","p",null,{"className":"mb-4","children":["Integration with NDT results provides context—understanding whether a detected defect falls in a stress concentration or a low-risk zone. This intersection of dimensional metrology and material characterization represents the future of comprehensive asset assessment. Platforms like ",["$","a",null,{"href":"https://ndt-connect.com","rel":"noopener","className":"text-indigo-600 hover:underline","children":"NDTConnect"}]," now integrate laser metrology data alongside traditional inspection results."]}],["$","h2",null,{"className":"text-2xl font-bold mb-4 mt-6","children":"Automated Guided Vehicles"}],["$","p",null,{"className":"mb-4","children":"Magnetic wheel crawlers, wheeled robots, and tracked platforms serve as mobile platforms for NDT sensors. Modern AGVs feature autonomous navigation, enabling programmable scan patterns that adapt to environmental feedback. Obstacle detection and dynamic path planning allow operation in cluttered industrial environments."}],["$","p",null,{"className":"mb-4","children":["The convergence of NDT robotics and broader industrial robotics ecosystems creates opportunities for integration with manufacturing and maintenance workflows. ",["$","a",null,{"href":"https://atlantisndt.com","rel":"noopener","className":"text-indigo-600 hover:underline","children":"NDT ERP software"}]," now interfaces with robotic fleet management systems, coordinating inspections across facilities seamlessly."]}]]}]]}],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","technologies","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/569e4f545aba4cff.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","children":["$","body",null,{"className":"bg-white text-gray-900","children":[["$","script",null,{"async":true,"src":"https://www.googletagmanager.com/gtag/js?id=G-1EF92RXSVR"}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"\n        window.dataLayer = window.dataLayer || [];\n        function gtag(){dataLayer.push(arguments);}\n        gtag('js', new Date());\n        gtag('config', 'G-1EF92RXSVR');\n      "}}],["$","header",null,{"className":"bg-indigo-600 text-white","children":["$","nav",null,{"className":"max-w-6xl mx-auto px-6 py-4 flex justify-between items-center","children":[["$","h1",null,{"className":"text-2xl font-bold","children":"NDT Automation Future"}],["$","div",null,{"className":"space-x-6","children":[["$","a",null,{"href":"/","className":"hover:text-indigo-200","children":"Home"}],["$","a",null,{"href":"/technologies","className":"hover:text-indigo-200","children":"Technologies"}],["$","a",null,{"href":"/implementation","className":"hover:text-indigo-200","children":"Implementation"}],["$","a",null,{"href":"/trends","className":"hover:text-indigo-200","children":"Trends"}]]}]]}]}],["$","main",null,{"className":"max-w-6xl mx-auto px-6 py-12","children":["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily"