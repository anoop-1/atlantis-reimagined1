// vercel.json — full config snippet
// ─────────────────────────────────
// Critical change: routes are explicit and don't fall back to /index.html
// for /ndt-erp-* paths.  The prerendered HTML files in dist/ will be served
// directly by Vercel's static handler.
//
// Drop into atlantis-reimagined1/vercel.json (replace the file).

{
  "buildCommand": "npm run build && node scripts/prerender.mjs && node scripts/build-sitemap.mjs",
  "outputDirectory": "dist",
  "framework": "vite",

  "rewrites": [
    // Static assets pass through
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },

    // Prerendered routes — Vercel's static handler picks these up first.
    // No rewrite needed for /ndt-erp-software, /ndt-erp-:slug, /:lang/ndt-erp-:slug
    // because the prerender step writes static HTML files at those exact paths.

    // SPA fallback for everything else NOT prerendered
    { "source": "/(.*)", "destination": "/index.html" }
  ],

  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
