# ── Deployment weight, added 2026-08-18 ──────────────────────────────────────
# Vercel builds dist itself (package.json "build" runs vite build + prerender),
# so nothing below needs to be uploaded on every deploy.

# Agent worktrees: 150 MB of full repo copies committed inside the repo.
.claude/

# Analysis artifacts. The SCRIPTS that produce these are tracked and re-runnable
# (diag-traffic, seg-deepdive, striking-distance, kpi-weekly, lint-citation-spec);
# their JSON output is a snapshot and does not belong in version control.
scripts/*-report.json
scripts/citation-spec-report.json
scripts/kpi-weekly-latest.json
scripts/routes-recovered.json
scripts/diag-traffic-*.json
scripts/seg-deepdive-*.json
scripts/striking-distance-*.json
scripts/content-briefs-*.json
scripts/trend-us-training.json
scripts/pricing-placeholder-backlog.json

